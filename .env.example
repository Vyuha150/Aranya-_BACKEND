PORT=4000
NODE_ENV=development

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB=aranya

# Signs admin session tokens. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3737

# First admin account, created by `npm run seed`.
ADMIN_NAME="Founders Studio"
ADMIN_EMAIL=admin@aranya.co
ADMIN_PASSWORD=change-me

# Where the storefront is served; password-reset links point here.
APP_URL=http://localhost:3737

# Outgoing mail for password-reset emails. Leave SMTP_HOST empty to send
# nothing: in development the reset link is printed to this server's log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aranya <no-reply@example.com>"
